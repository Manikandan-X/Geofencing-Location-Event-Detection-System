# ==============================
# Application
# ==============================

APP_NAME=Geofencing Location Event Detection System
APP_VERSION=1.0.0
DEBUG=False


# ==============================
# Database
# ==============================

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=geofence_db
MYSQL_USER=sync_user
MYSQL_PASSWORD=your_password
MYSQL_ROOT_PASSWORD=your_root_password

DATABASE_URL=mysql+pymysql://sync_user:your_password@mysql:3306/geofence_db


# ==============================
# Redis
# ==============================

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=300


# ==============================
# JWT
# ==============================

JWT_SECRET_KEY=change-this-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60